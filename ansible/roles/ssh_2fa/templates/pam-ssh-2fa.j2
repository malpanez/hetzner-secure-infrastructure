# PAM SSH 2FA substack - /etc/pam.d/sshd-2fa
# Managed by Ansible - ssh_2fa role
# Included via "auth [success=done default=ignore] substack sshd-2fa".
#
# NOTE: in the FIDO2 design (recommended) SSH uses hardware-key verify-required
# and this TOTP-over-SSH substack is NOT wired — it exists for the optional
# ssh_2fa_enable_ssh (TOTP) mode. Break-glass and automation are exempted at the
# sshd Match layer (AuthenticationMethods publickey, no keyboard-interactive), so
# they never reach this substack; the pam_succeed_if skips below are defence in
# depth. forward_pass was REMOVED: there is no prior password factor to forward
# on the SSH keyboard-interactive path, so it was meaningless.
{% for grp in [ssh_2fa_breakglass_group | default('breakglass'), ssh_2fa_automation_group | default('ansible-automation')] %}
auth [success=done default=ignore] pam_succeed_if.so quiet user ingroup {{ grp }}
{% endfor %}
auth required pam_google_authenticator.so {% if ssh_2fa_totp_nullok | default(true) %}nullok{% endif %}
