# SSH 2FA (TOTP-over-SSH mode) - /etc/ssh/sshd_config.d/50-2fa.conf
# Managed by Ansible - ssh_2fa role
# Deployed only when ssh_2fa_enable_ssh is true. MUTUALLY EXCLUSIVE with
# ssh_2fa_fido2_only (the role asserts one-xor-the-other) so the two drop-ins
# never fight over a global AuthenticationMethods (lexical 20 < 50, first value
# wins). In the recommended design SSH uses FIDO2 (sshd_fido2.conf.j2) and this
# file is NOT rendered.
KbdInteractiveAuthentication yes
UsePAM yes
PubkeyAuthentication {{ ssh_2fa_pubkey_authentication }}

# Match blocks are evaluated in order; the FIRST matching block wins for a
# connection, so the exempt (single-factor) accounts MUST precede "Match All".
# Break-glass + automation: SSH key only, no TOTP challenge.
Match Group {{ ssh_2fa_breakglass_group | default('breakglass') }}
    AuthenticationMethods publickey
    PubkeyAuthOptions none
Match Group {{ ssh_2fa_automation_group | default('ansible-automation') }}
    AuthenticationMethods publickey
    PubkeyAuthOptions none
{% for u in ssh_2fa_break_glass_users | default([]) %}
Match User {{ u }}
    AuthenticationMethods publickey
    PubkeyAuthOptions none
{% endfor %}
# Everyone else: publickey + TOTP (keyboard-interactive via the sshd-2fa substack).
Match All
    AuthenticationMethods {{ ssh_2fa_auth_methods }}
