# SSH FIDO2 hardware-key configuration - /etc/ssh/sshd_config.d/20-fido2.conf
# Managed by Ansible - ssh_2fa role
# Deployed when ssh_2fa_fido2_only is true (MUTUALLY EXCLUSIVE with
# ssh_2fa_enable_ssh; the role asserts one-xor-the-other).
#
# Model: the hardware sk-* key IS the SSH second factor (possession of the key +
# a PIN via verify-required). No keyboard-interactive/TOTP at the SSH layer; TOTP
# is enforced at sudo instead. Break-glass + automation accounts are relaxed to a
# plain (non-FIDO) key via per-Match PubkeyAuthOptions overrides below.

# -- Global FIDO2 baseline (applies to everyone NOT matched below) ------------
PubkeyAcceptedAlgorithms {{ ssh_2fa_fido2_pubkey_algorithms | join(',') }}
PubkeyAuthOptions verify-required
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
HostbasedAuthentication no
GSSAPIAuthentication no

# -- Break-glass + automation exemptions --------------------------------------
# sshd_config(5): "If all of the criteria on the Match line are satisfied, the
# keywords on the following lines override those set in the global section."
# So a matching connection gets PubkeyAuthOptions none (accepts the plain recovery
# / automation key) even though the global default above is verify-required. These
# blocks live in THIS file (not 50-2fa.conf) so they exist in FIDO2 mode; verify
# the effective policy per account with `sshd -T -C user=<u>,addr=<ip>`.
Match Group {{ ssh_2fa_breakglass_group | default('breakglass') }}
    AuthenticationMethods publickey
    PubkeyAuthOptions none
Match Group {{ ssh_2fa_automation_group | default('ansible-automation') }}
    AuthenticationMethods publickey
    PubkeyAuthOptions none
{% for u in ssh_2fa_break_glass_users | default([]) %}
Match User {{ u }}
    AuthenticationMethods publickey
    PubkeyAuthOptions none
{% endfor %}
# Reset the Match context to global: OpenSSH Match scope persists to EOF AND across
# sshd_config.d Include boundaries, so without this a lexically-later drop-in's
# global directive would be captured under the last Match block above.
Match all

#
# Enrolment (on a machine where the YubiKey is reachable, e.g. Windows-native, NOT
# WSL2): ssh-keygen -t ecdsa-sk -O resident -O verify-required (or ed25519-sk).
# The enforced daily user's authorized_keys must be sk-ONLY; the plain recovery
# ed25519 belongs ONLY to the break-glass account. Prove sk login in a second
# session (break-glass session held open) before trusting enforcement.
