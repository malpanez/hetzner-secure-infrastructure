# PAM MFA TOTP substack (root-owned secrets) - /etc/pam.d/mfa-totp
# Managed by Ansible - ssh_2fa role
# Included via "auth substack mfa-totp". Only auth-type lines execute when a file
# is pulled in as an auth substack, so the previous account/session directives
# were removed (they were dead config that never ran and misled maintainers).
#
# nullok is load-bearing DURING ROLLOUT: pam_google_authenticator under `required`
# fails closed on a missing secret, so a user added to {{ ssh_2fa_mfa_required_group }}
# before their /var/lib/pam-google-authenticator/<user>/.google_authenticator exists
# would be denied sudo. Keep ssh_2fa_totp_nullok=true until every member is enrolled
# AND verified with pamtester, then set it false to make TOTP mandatory.
#
# ${USER} is a PAM runtime variable (expanded per authentication), NOT Jinja.
# user=root reads the root-owned secret; the user cannot read or tamper with it.
auth required pam_google_authenticator.so {% if ssh_2fa_totp_nullok | default(true) %}nullok {% endif %}no_increment_hotp secret={{ ssh_2fa_totp_secret_base }}/${USER}/.google_authenticator user=root
